import torch
import torch.nn as nn
import torch.optim as optim
import itertools

torch.manual_seed(42)

def generate_symmetry_data():
    inputs = list(itertools.product([0.0, 1.0], repeat=6))
    X = torch.tensor(inputs, dtype=torch.float32)
    Y = torch.zeros((64, 1), dtype=torch.float32)
    
    for i in range(64):
        vec = inputs[i]
        is_symmetric = (vec == vec[::-1])
        Y[i, 0] = 1.0 if is_symmetric else 0.0
        
    return X, Y

class BackpropNet(nn.Module):
    def __init__(self):
        super(BackpropNet, self).__init__()
        self.hidden = nn.Linear(6, 8)
        self.output = nn.Linear(8, 1)
        
        nn.init.uniform_(self.hidden.weight, -0.3, 0.3)
        nn.init.uniform_(self.hidden.bias, -0.3, 0.3)
        nn.init.uniform_(self.output.weight, -0.3, 0.3)
        nn.init.uniform_(self.output.bias, -0.3, 0.3)

    def forward(self, x):
        out_hidden = torch.sigmoid(self.hidden(x))
        out_final = torch.sigmoid(self.output(out_hidden))
        return out_final

def train_and_evaluate():
    X, Y = generate_symmetry_data()
    model = BackpropNet()
    
    criterion = nn.MSELoss(reduction='mean')
    
    optimizer = optim.SGD(model.parameters(), lr=1.5, momentum=0.9)
    
    epochs = 3000
    
    print("Starting Training (Back-propagation with Momentum)...")
    print("-" * 50)
    
    for epoch in range(epochs):
        predictions = model(X)
        loss = criterion(predictions, Y)
        
        optimizer.zero_grad()
        loss.backward()
        optimizer.step()
        
        if (epoch + 1) % 500 == 0:
            print(f"Epoch {epoch + 1:4d}/{epochs} | Mean MSE Loss: {loss.item():.4f}")

    print("-" * 50)
    print("Evaluating with Paper's Custom Metric...")
    with torch.no_grad():
        final_preds = model(X)
        
        correct_cases = 0
        for i in range(64):
            target = Y[i, 0].item()
            pred = final_preds[i, 0].item()
            
            if target == 1.0 and pred > 0.8:
                correct_cases += 1
            elif target == 0.0 and pred < 0.2:
                correct_cases += 1
                
        accuracy = (correct_cases / 64) * 100
        
        print(f"Total Cases: 64")
        print(f"Correctly Classified (using >0.8 / <0.2 thresholds): {correct_cases}")
        print(f"Final Accuracy: {accuracy:.2f}%\n")
        
        print("Sample Predictions vs Targets:")
        for i in [0, 15, 30, 45, 63]: 
            symmetric_status = "Symmetric" if Y[i,0] == 1.0 else "Asymmetric"
            print(f"Input: {X[i].int().tolist()} ({symmetric_status}) | Target: {Y[i,0].item()} | Output: {final_preds[i,0].item():.4f}")

if __name__ == "__main__":
    train_and_evaluate()
